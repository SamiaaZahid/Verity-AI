# ==========================================
# Verity AI - Environment Configuration
# ==========================================

# 1. Nebius Token Factory API Key (Required)
# Sign up and obtain key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# 2. Tavily Search API Key (Required)
# Sign up and obtain key at: https://tavily.com
TAVILY_API_KEY=

# 3. Nebius Base URL (Optional, defaults to https://api.tokenfactory.nebius.com/v1/)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# 4. Nebius Model Name (Optional, if empty or unset, queries Nebius /models and auto-selects)
NEBIUS_MODEL=
